server {
    listen 80;
    server_name banco-de-especialistas.ifg.edu.br 200.18.161.30;

    client_max_body_size 15M;

    location /static/ {
        alias /var/www/html/banco-talentos/django_app/staticfiles/;
    }

    location /media/ {
        alias /var/www/html/banco-talentos/django_app/media/;
        internal;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/run/banco-talentos/gunicorn.sock;
    }
}
