# ============================================================
# BANCO DE TALENTOS IFG — .env.example
# Copie para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# ============================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1

# Suspensão temporária das inscrições: False fecha o formulário
# (candidatos ainda logam e veem inscrições já enviadas).
# Religar = True (ou remover a linha) + restart do serviço.
INSCRICOES_ABERTAS=True

# Banco de dados PostgreSQL
DB_NAME=banco_talentos_db
DB_USER=banco_talentos_user
DB_PASSWORD=troque-pela-senha-do-banco
DB_HOST=localhost
DB_PORT=5432

# Upload
MEDIA_ROOT=media/
MAX_UPLOAD_MB=10

# E-mail (para recuperação de senha e notificações)
EMAIL_HOST=smtp.ifg.edu.br
EMAIL_PORT=587
EMAIL_HOST_USER=bancodatalentos@ifg.edu.br
EMAIL_HOST_PASSWORD=troque-pela-senha-do-email
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Banco de Talentos IFG <bancodatalentos@ifg.edu.br>
